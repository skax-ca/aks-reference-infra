#!/usr/bin/env bash
# pre-commit: OpenTofu 로컬 게이트(fmt → tflint → trivy) + 문서·주석 게이트
# 활성화: git config core.hooksPath .githooks  (clone마다 1회)
# 의도적 우회는 git commit --no-verify (사유를 커밋 메시지에 남길 것)
set -euo pipefail

changed=$(git diff --cached --name-only --diff-filter=ACMR)

# 문서 작성 규칙(iac-module-library docs/conventions.md에서 이식). 절 번호 인용·비표준 이모지·
# 400줄 초과·em-dash를 기계로 잡는다. 적용 범위는 스크립트가 스스로 선언한 것과 같다:
# docs/*.md · 저장소 전역 README.md·AGENTS.md · 루트 CLAUDE.md. staged된 파일만 검사한다.
docs_staged=$(printf '%s\n' "$changed" | grep -E '^docs/.*\.md$|(^|/)README\.md$|(^|/)AGENTS\.md$|^CLAUDE\.md$' || true)
if [ -n "$docs_staged" ]; then
  echo "[pre-commit] 문서 변경 감지. 작성 규칙 검사"
  # shellcheck disable=SC2086
  python3 scripts/validate-doc-conventions.py $docs_staged
fi

# 주석 규칙(iac-module-library docs/conventions.md 「주석」에서 이식). 주석 줄의 좌표(절 번호·
# 날짜·결정 식별자·사건 서술)와 모든 줄의 em-dash를 기계로 잡는다. staged된 파일만 검사한다.
code_staged=$(printf '%s\n' "$changed" | grep -v '/\.terraform/' |
  grep -E '^live/.*\.tf$|^bootstrap/.*\.sh$|^scripts/.*\.(sh|py)$|^\.githooks/|^\.claude/skills/.*\.sh$|^\.github/workflows/.*\.yml$' || true)
if [ -n "$code_staged" ]; then
  echo "[pre-commit] 코드 변경 감지. 주석 규칙 검사"
  # shellcheck disable=SC2086
  python3 scripts/validate-comment-conventions.py $code_staged
fi

# Terraform 관련 파일이 staged된 경우에만 실행 (문서 커밋엔 비용 0)
staged=$(printf '%s\n' "$changed" |
  grep -E '\.(tf|tfvars)$|\.terraform\.lock\.hcl$|^\.tflint\.hcl$|^\.trivyignore$' || true)
[ -z "$staged" ] && exit 0

echo "[pre-commit] Terraform 변경 감지. 로컬 게이트 실행"

echo "  1/4 backend.hcl 유출 검사"
# state Storage Account명은 git에 들어가지 않는다(계정 식별 정보. GitHub 저장소 변수와 로컬
# backend.hcl에만 둔다). .gitignore가 1차, 이 훅이 마지막 방어선이다.
if printf '%s\n' "$changed" | grep -qE '(^|/)backend(\..+)?\.hcl$'; then
  echo "  ✗ backend.hcl 이 staged 되었다. .gitignore 를 우회했다는 뜻이다." >&2
  echo "    이 파일에는 state Storage Account명이 있다. git에 두지 않는 것이 규칙이다(CLAUDE.md 실행 모델 표)." >&2
  echo "    git restore --staged <파일> 로 제외할 것." >&2
  exit 1
fi

echo "  2/4 tofu fmt -check"
tofu fmt -recursive -check

echo "  3/4 tflint --recursive"
# 플러그인(azurerm ruleset)이 없으면 tflint가 실패한다. clone마다 1회 `tflint --init`.
tflint --recursive

echo "  4/4 trivy config (MEDIUM+)"
# .terraform/(init 캐시)과 다운로드된 원격 모듈 내부는 upstream 코드라 게이트 대상에서 제외한다.
# 이 repo는 배포 루트라 사실상 모든 리소스가 모듈 안에 있다: 여기서 잡는 것은
# 루트가 직접 쓰는 provider·backend 설정과 루트 리소스(identity·role assignment·azapi 등)뿐이다.
trivy config --quiet --exit-code 1 --severity MEDIUM,HIGH,CRITICAL \
  --skip-dirs '**/.terraform' --tf-exclude-downloaded-modules .

echo "[pre-commit] 게이트 통과 ✓"
