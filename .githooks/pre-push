#!/usr/bin/env bash
# pre-push: 배포 루트 validate(push 범위에 live/ 변경이 있을 때만)
# 활성화: git config core.hooksPath .githooks
#
# ⚠️ 모듈 repo의 pre-push와 다르다. 이 repo에는 modules/가 없어 tofu test 대상이 없다.
# 계약 검증은 iac-module-library 의 modules/azure/*/tests/ 가 이미 담당한다.
# 여기서 잡을 것은 "루트가 모듈을 올바르게 호출하는가"이고, 그것은 validate 로 잡힌다.
set -euo pipefail

zero="0000000000000000000000000000000000000000"
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch 삭제 push
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "$local_sha^")
    range_diff=$(git diff --name-only "$base".."$local_sha" 2>/dev/null || true)
  else
    range_diff=$(git diff --name-only "$remote_sha".."$local_sha")
  fi
  changed="$changed"$'\n'"$range_diff"
done

echo "$changed" | grep -qE '^live/.*\.tf$' || exit 0

echo "[pre-push] live/ 변경 감지. validate 실행"
for root in live/*/*/; do
  [ -n "$(find "$root" -maxdepth 1 -name '*.tf' -print -quit 2>/dev/null)" ] || continue
  echo "  validate: $root"
  # -backend=false: state 접근 없이 검증한다. backend는 partial 설정이라
  # 실제 init 에는 -backend-config 가 필요한데, 훅이 Storage Account명을 알 필요는 없다.
  # 모듈 소싱(git tag)은 여기서 실제로 일어난다. 로컬 credential helper가 인증을 공급한다.
  # -upgrade 를 붙이지 않는다: .terraform.lock.hcl 의 provider 핀이 조용히 바뀐다.
  tofu -chdir="$root" init -backend=false -input=false > /dev/null
  tofu -chdir="$root" validate
done

echo "[pre-push] validate 통과 ✓"
